{
  "name": "@board/cli-installer",
  "version": "0.1.0",
  "description": "CLI Installer for Board Plugin - Install and configure Board Plugin for AI agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "board-cli": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js",
      "require": "./dist/cli.js"
    }
  },
  "files": ["dist/**/*"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@board/core-engine": "workspace:*",
    "@board/config-manager": "workspace:*",
    "@board/board-database": "workspace:*",
    "@board/hardware-detection": "workspace:*",
    "@board/serial-comm": "workspace:*",
    "@board/arduino-manager": "workspace:*",
    "@board/esp-manager": "workspace:*",
    "@board/platformio-manager": "workspace:*",
    "@board/mcp-server": "workspace:*",
    "commander": "^12.1.0",
    "fs-extra": "^11.2.0",
    "inquirer": "^10.0.0",
    "pino": "^9.3.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/fs-extra": "^11.0.4",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}