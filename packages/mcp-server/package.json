{
  "name": "@board/mcp-server",
  "version": "0.1.0",
  "description": "MCP Server for Board Plugin - AI agent tools for hardware programming",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": ["dist/**/*"],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@board/core-engine": "workspace:*",
    "@board/board-database": "workspace:*",
    "@board/hardware-detection": "workspace:*",
    "@board/serial-comm": "workspace:*",
    "@board/arduino-manager": "workspace:*",
    "@board/esp-manager": "workspace:*",
    "@board/platformio-manager": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "eslint": "^9.9.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}